# ==============================================================================
# AxonPG Configuration
# ==============================================================================
AXONPG_MODE=docker            # docker | lite
AXONPG_DB_HOST=127.0.0.1
AXONPG_DB_PORT=5435
AXONPG_DB_NAME=axonpg
AXONPG_DB_USER=axonpg
AXONPG_DB_PASSWORD=change_me_strong_password

# ------------------------------------------------------------------------------
# Embeddings Provider (elige uno: fastembed | ollama | nvidia | openrouter | gemini | openai | custom)
# ------------------------------------------------------------------------------
AXONPG_EMBED_PROVIDER=fastembed
AXONPG_EMBED_MODEL=BAAI/bge-small-en-v1.5
AXONPG_EMBED_DIM=384          # 384 (bge-small/MiniLM) | 768 (nomic/gemini) | 1024 (bge-m3/nvidia) | 1536 (openai)
AXONPG_EMBED_API_KEY=
AXONPG_EMBED_BASE_URL=        # Ej. https://integrate.api.nvidia.com/v1 o https://openrouter.ai/api/v1

# ------------------------------------------------------------------------------
# Consolidation / Reflection LLM (opcional, para sueno nocturno MemScene/Foresight)
# ------------------------------------------------------------------------------
AXONPG_LLM_PROVIDER=openrouter
AXONPG_LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
AXONPG_LLM_API_KEY=
AXONPG_LLM_BASE_URL=https://openrouter.ai/api/v1
