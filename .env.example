# ==============================================================================
# AxonPG Configuration (.env)
# ==============================================================================
# Storage mode: "docker" (PostgreSQL + pgvector) | "lite" (Zero-Docker SQLite + FTS5)
AXONPG_MODE=docker
AXONPG_NAMESPACE=default
AXONPG_LANG=auto              # auto | en | es | pt | fr

# SQLite --lite path (used only when AXONPG_MODE=lite)
AXONPG_SQLITE_PATH=~/.axonpg/axonpg.db

# PostgreSQL connection (used when AXONPG_MODE=docker)
AXONPG_DB_HOST=127.0.0.1
AXONPG_DB_PORT=5435
AXONPG_DB_NAME=axonpg
AXONPG_DB_USER=axonpg
AXONPG_DB_PASSWORD=axonpg_change_me

# ------------------------------------------------------------------------------
# Embeddings Provider
# Options: fastembed | ollama | nvidia | openrouter | gemini | openai | custom | none
# Multilingual defaults recommended:
#   - fastembed:  sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 (384d, 50+ langs)
#   - ollama:     bge-m3 (1024d, 100+ langs) or nomic-embed-text (768d)
#   - nvidia:     baai/bge-m3 (1024d) or nvidia/llama-3.2-nv-embedqa-1b-v2 (2048d)
#   - openrouter: baai/bge-m3 or openai/text-embedding-3-small (1536d)
#   - gemini:     gemini-embedding-001 (768d)
#   - openai:     text-embedding-3-small (1536d)
# ------------------------------------------------------------------------------
AXONPG_EMBED_PROVIDER=fastembed
AXONPG_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
AXONPG_EMBED_DIM=384
AXONPG_EMBED_API_KEY=
AXONPG_EMBED_BASE_URL=

# ------------------------------------------------------------------------------
# Optional Sleep-Time Consolidation LLM
# Options: none | openrouter | nvidia | ollama | gemini | openai | custom
# Note: "none" uses deterministic rule-based consolidation (works offline / $0).
# ------------------------------------------------------------------------------
AXONPG_LLM_PROVIDER=none
AXONPG_LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
AXONPG_LLM_API_KEY=
AXONPG_LLM_BASE_URL=
